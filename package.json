{
  "name": "hearth-imessage-sync",
  "version": "1.1.0",
  "description": "Sync iMessages to Hearth Rolodex",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:publish": "electron-builder --mac --publish always"
  },
  "author": "Hearth",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "dotenv": "^16.3.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "sql.js": "^1.10.0"
  },
  "build": {
    "appId": "ai.hearth.app",
    "productName": "Hearth",
    "icon": "icon.icns",
    "protocols": {
      "name": "Hearth Sync Protocol",
      "schemes": ["hearth-sync"]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "icon.icns",
      "identity": null
    },
    "publish": {
      "provider": "github",
      "owner": "ashemag",
      "repo": "hearth-imessage-sync",
      "releaseType": "release"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!scripts"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  }
}
